error_log /dev/stdout info;

events {
    worker_connections          1024;
}

http {
    access_log                  /dev/stdout;
    default_type                application/javascript;
    server {
        listen                  80;
        absolute_redirect       off;
        root                    ${TEMP_DIR};

        # Client installers (see client/). The PAC URL the client used to
        # reach this server is filled in, so they need no other config.
        location ~ ^/(install\.sh|install\.ps1)$ {
            default_type        text/plain;
            sub_filter          '__PAC_URL__' '$scheme://$http_host/proxy.pac';
            sub_filter_types    *;
            sub_filter_once     off;
        }

        # Usage dashboard (app/stats). Access rules come from STATS_ALLOW /
        # STATS_PASSWORD, see app/nginx/run.
        location = /stats {
            return              301 /stats/;
        }
        location ^~ /stats/data/ {
            include             ${TEMP_DIR}/stats_access.conf;
            alias               ${STATS_LOG_DIR}/stats/data/;
            default_type        text/plain;
            charset             utf-8;
            add_header          Cache-Control "no-store";
        }
        location ^~ /stats/ {
            include             ${TEMP_DIR}/stats_access.conf;
            alias               /app/stats/www/;
            index               index.html;
            default_type        text/html;
            charset             utf-8;
            add_header          Cache-Control "no-cache";
        }

        location / {
            rewrite             ^ /proxy.pac break;
        }
    }
}
