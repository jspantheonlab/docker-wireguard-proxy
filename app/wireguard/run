#!/bin/sh

ifname=$(basename $(ls -1 ${WG_CONFIG}/*.conf | head -1) .conf)

ifpath=${WG_CONFIG}/$ifname.conf

if [ ! -f "${ifpath}" ] ; then
    echo "No Wireguard config. Exiting."
    exit 1
fi

cleanup()
{
    echo "stopping wg interface..."
    wg-quick down "${ifpath}" || true
}
trap cleanup INT HUP SIGINT

get_ip()
{
    curl -4 -s --max-time 10 --retry 2 https://ifconfig.me 2>/dev/null ||
        curl -4 -s --max-time 10 https://api.ipify.org 2>/dev/null
}

oldip=$(get_ip)

echo "starting wg interface..."
sysctl -w net.ipv4.ip_forward=1 && sysctl -w net.ipv4.conf.all.forwarding=1
wg-quick up ${ifpath}
wg show

echo "Regular IP: ${oldip:-<unavailable>}"

newip=$(get_ip)
echo "Wireguard IP: ${newip:-<unavailable>}"

sleep infinity &
wait
