    {
      "type": "bargauge",
      "title": "Top devices",
      "description": "Busiest devices in the selected range.",
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
